{
    "name": "Mark It Down",
    "short_name": "Markitdown",
    "description": "Focused Markdown Reader and Editor",
    "start_url": "/apps/markitdown/",
    "display": "standalone",
    "background_color": "#1e1e2e",
    "theme_color": "#1e1e2e",
    "lang": "en",
    "scope": "/apps/markitdown/",
    "id": "/apps/markitdown/",
    "icons": [
        {
            "src": "favicon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "favicon.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "text/markdown": [
                    ".md"
                ],
                "text/plain": [
                    ".txt"
                ]
            }
        }
    ]
}