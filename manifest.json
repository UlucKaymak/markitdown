{
  "name": "mark it down",
  "short_name": "mark it down",
  "description": "Markdown reader and editor",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#1e1e2e",
  "theme_color": "#1e1e2e",
  "icons": [
    {
      "src": "favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Markdown Document",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkdn", ".mdwn", ".mkd", ".rmd", ".text"],
        "text/plain": [".txt"]
      },
      "icons": [
        {
          "src": "favicon.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    }
  ]
}
